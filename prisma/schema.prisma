// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(LEARNER)

  appSessions      AppSession[]
  studyAttempts    StudyAttempt[]
  wordProgressList UserWordProgress[]
}

enum UserRole {
  ADMIN
  LEARNER
}

model KanjiWord {
  id      Int    @id @default(autoincrement())
  word    String @unique
  reading String
  meaning String

  kanjiList KanjiChar[] // 관계 설정

  studyAttempts StudyAttempt[]
  userProgress  UserWordProgress[]

  createdAt DateTime @default(now())
}

model AppSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StudyAttempt {
  id            String   @id @default(cuid())
  clientEventId String   @unique
  userId        Int
  wordId        Int
  isCorrect     Boolean
  answeredAt    DateTime
  createdAt     DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word KanjiWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([userId, wordId])
}

model UserWordProgress {
  id             String    @id @default(cuid())
  userId         Int
  wordId         Int
  correctCount   Int       @default(0)
  wrongCount     Int       @default(0)
  lastResult     Boolean?
  lastAnsweredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word KanjiWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, lastAnsweredAt])
}

model KanjiChar {
  id       Int     @id @default(autoincrement())
  kanji    String
  onyomi   String
  kunyomi  String?
  position Int // 1~4번째 위치

  wordId Int
  word   KanjiWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
